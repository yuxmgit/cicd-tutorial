# ============================================================
# cicd-tutorial 环境变量样例
# 用法：cp .env.example .env  然后改值
# 铁律：.env 永远不进 Git 仓库；真实密钥只存在于 Jenkins 凭据或服务器上
# ============================================================

# ---------- 部署目标（生产机） ----------
DEPLOY_HOST=49.234.202.181       # 腾讯云 CVM 公网地址（SSH 别名 yengxun-yun）
DEPLOY_USER=ubuntu               # 非 root 用户，靠 sudo 提权；第 11 章讲为什么这样更安全
DEPLOY_PORT=22
APP_BASE_DIR=/opt/apps/cicd-demo # releases/ shared/ current/ 三兄弟的家（需 sudo 创建）

# ---------- 应用（后端） ----------
APP_ENV=production               # development / production
APP_PORT=8000                    # 容器内 FastAPI 端口
APP_SECRET_KEY=change-me-to-a-long-random-string   # 生成：python -c "import secrets;print(secrets.token_hex(32))"
SQLITE_PATH=/data/app.db         # 宿主机挂载点，容器内映射到应用可写路径
LOG_LEVEL=info

# ---------- 应用（前端） ----------
WEB_PORT=8443                    # 对外端口：避开宝塔已占用的 80/443/888/8888
VITE_API_BASE=/api               # 生产走 Nginx 反代同源；本地开发才用 http://127.0.0.1:8000

# ---------- 镜像仓库（GitHub GHCR，公开镜像免费） ----------
REGISTRY=ghcr.io                  # 命名空间 = GitHub 用户名/组织名（全小写）；华为云场景换成 swr.cn-north-4.myhuaweicloud.com
REGISTRY_NAMESPACE=yxm1989614     # GitHub 用户名；包推送后记得在 Packages 页面设为 Public
IMAGE_FRONTEND=${REGISTRY}/${REGISTRY_NAMESPACE}/cicd-demo-frontend  # 完整拼装与登录见第 10 章
IMAGE_BACKEND=${REGISTRY}/${REGISTRY_NAMESPACE}/cicd-demo-backend

# ---------- HTTPS（无域名方案） ----------
TLS_MODE=self-signed             # self-signed / sslip / real-domain（买了域名后切换）
TLS_DOMAIN=124.70.96.225.sslip.io

# ---------- Jenkins（本地 CI 机） ----------
JENKINS_PORT=8080                # 本地 Jenkins 界面端口
JENKINS_HOME_VOLUME=jenkins-home # Docker 卷名，备份它 = 备份整个 Jenkins
