# 第 15 章使用：给 Jenkins 容器补齐端到端流水线所需的工具
# 启动：docker compose -f pipelines/jenkins/docker-compose.jenkins.yml up -d --build
# 在官方镜像（Debian bookworm）基础上加装：
#   openssh-client  —— scp/ssh 部署到生产机
#   docker CLI      —— 通过挂载的 /var/run/docker.sock 复用宿主 Docker 构建镜像
#   python3 + venv + pip-audit —— 后端 pytest 与依赖扫描
#   nodejs + npm    —— 前端 lint / vitest / vite build 与依赖扫描
#   trivy           —— 镜像漏洞扫描门禁
FROM jenkins/jenkins:lts-jdk17

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client \
        python3 python3-venv python3-pip \
        nodejs npm \
        curl ca-certificates \
    && PIP_BREAK_SYSTEM_PACKAGES=1 pip3 install --no-cache-dir pip-audit \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI（静态二进制，只要客户端；守护进程用宿主的）
RUN curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz" \
      | tar xz --strip-components=1 -C /usr/local/bin docker/docker \
    && docker --version

# Trivy 镜像扫描器
RUN curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v0.58.2/trivy_0.58.2_Linux-64bit.tar.gz" \
      | tar xz -C /usr/local/bin trivy \
    && trivy --version

USER jenkins
